<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework themes only: the helper carries no AndroidX UI libraries. values-night swaps the parent. -->
    <style name="Base.Theme.KakaoDbHelper" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.KakaoDbHelper" parent="Base.Theme.KakaoDbHelper">
        <item name="android:colorPrimary">@color/kdb_accent</item>
        <item name="android:colorAccent">@color/kdb_accent</item>
        <item name="android:windowBackground">@color/kdb_background</item>
        <item name="android:statusBarColor">@color/kdb_background</item>
        <item name="android:windowLightStatusBar">@bool/kdb_light_bars</item>
        <item name="android:textColorPrimary">@color/kdb_text</item>
        <item name="android:textColorSecondary">@color/kdb_text_secondary</item>
    </style>

    <style name="KakaoDbHelper.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/kdb_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="KakaoDbHelper.List" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:divider">@drawable/divider_inset</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="KakaoDbHelper.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/kdb_button_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
